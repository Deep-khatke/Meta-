<?xml version="1.0"?>
<!--
  RoboForge 4-Joint Articulated Arm
  A fixed-base serial manipulator with 4 revolute joints and a 2-finger gripper.
  Axes alternate Z (yaw) / Y (pitch) so the arm has a natural reachable workspace:
    joint_1  shoulder yaw   (Z)
    joint_2  shoulder pitch (Y)
    joint_3  elbow pitch    (Y)
    joint_4  wrist pitch    (Y)
  Each link's visual/collision is offset up its own +Z so segments connect end-to-end
  with no floating gaps. All <limit> values are in radians.

  Import:  Robot Studio  ->  URDF  (or the "URDF" button in the top toolbar)  ->  pick this file.
-->
<robot name="four_joint_arm">

  <!-- Colors -->
  <material name="steel">  <color rgba="0.17 0.21 0.28 1.0"/></material>
  <material name="blue">   <color rgba="0.17 0.42 0.69 1.0"/></material>
  <material name="orange"> <color rgba="0.87 0.42 0.13 1.0"/></material>
  <material name="teal">   <color rgba="0.06 0.46 0.43 1.0"/></material>
  <material name="green">  <color rgba="0.06 0.73 0.51 1.0"/></material>

  <!-- ===================== BASE PEDESTAL ===================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><cylinder radius="0.12" length="0.12"/></geometry>
      <material name="steel"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><cylinder radius="0.12" length="0.12"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.06"/>
      <mass value="5.0"/>
      <inertia ixx="0.05" iyy="0.05" izz="0.08" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ===================== LINK 1 : shoulder yaw ===================== -->
  <link name="link_1">
    <visual>
      <origin xyz="0 0 0.17" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.34"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.17" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.34"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.17"/>
      <mass value="1.4"/>
      <inertia ixx="0.012" iyy="0.012" izz="0.006" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="12.0" velocity="2.0"/>
  </joint>

  <!-- ===================== LINK 2 : shoulder pitch ===================== -->
  <link name="link_2">
    <visual>
      <origin xyz="0 0 0.145" rpy="0 0 0"/>
      <geometry><cylinder radius="0.046" length="0.29"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.145" rpy="0 0 0"/>
      <geometry><cylinder radius="0.046" length="0.29"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.145"/>
      <mass value="1.15"/>
      <inertia ixx="0.009" iyy="0.009" izz="0.004" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.34" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.35" upper="2.35" effort="12.0" velocity="2.0"/>
  </joint>

  <!-- ===================== LINK 3 : elbow pitch ===================== -->
  <link name="link_3">
    <visual>
      <origin xyz="0 0 0.123" rpy="0 0 0"/>
      <geometry><cylinder radius="0.042" length="0.246"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.123" rpy="0 0 0"/>
      <geometry><cylinder radius="0.042" length="0.246"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.123"/>
      <mass value="0.9"/>
      <inertia ixx="0.006" iyy="0.006" izz="0.003" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 0.29" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.60" upper="2.60" effort="10.0" velocity="2.5"/>
  </joint>

  <!-- ===================== LINK 4 : wrist pitch (+ gripper palm) ===================== -->
  <link name="link_4">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.11 0.04 0.06"/></geometry>
      <material name="teal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><box size="0.11 0.04 0.06"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03"/>
      <mass value="0.3"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0 0 0.246" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.00" upper="3.00" effort="8.0" velocity="3.0"/>
  </joint>

  <!-- ===================== GRIPPER FINGERS (fixed) ===================== -->
  <link name="finger_left">
    <visual>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry><box size="0.024 0.024 0.09"/></geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry><box size="0.024 0.024 0.09"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.045"/>
      <mass value="0.05"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="finger_left_fixed" type="fixed">
    <parent link="link_4"/>
    <child link="finger_left"/>
    <origin xyz="0 0.035 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="finger_right">
    <visual>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry><box size="0.024 0.024 0.09"/></geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry><box size="0.024 0.024 0.09"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.045"/>
      <mass value="0.05"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="finger_right_fixed" type="fixed">
    <parent link="link_4"/>
    <child link="finger_right"/>
    <origin xyz="0 -0.035 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

</robot>
