# ==============================================================================
# RoboForge Environment Configuration (.env)
# ==============================================================================

# Server & Host Settings
HOST=127.0.0.1
PORT=8000
APP_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# SQLite Database Location (optional override, defaults to backend/roboforge.db)
# ROBOFORGE_DB_PATH=backend/roboforge.db

# ------------------------------------------------------------------------------
# Google Gemini AI Configuration (Autonomous AI Co-Pilot & Scene Generation)
# ------------------------------------------------------------------------------
# Add your own Gemini API key to activate the Autonomous AI Co-Pilot,
# natural-language robotics commands, and AI scene generation.
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Google OAuth 2.0 Client Configuration
VITE_GOOGLE_CLIENT_ID=567256736468-3m5c2l0i74tronhurhm14mu174qkjbtc.apps.googleusercontent.com


# ------------------------------------------------------------------------------
# PayPal Subscriptions Sandbox Configuration
# ------------------------------------------------------------------------------
# Set to 'sandbox' for testing. Never use 'live' until fully tested and approved.
PAYPAL_ENV=sandbox

# Sandbox REST App Client ID (provided for sandbox testing)
PAYPAL_CLIENT_ID=BAARXgyIwc813ICUv3wOEA_iF5T3ngyOGDVk-fEPz4im16dEZoYhKaYHMI8ZXG1g_VygwMmCP73XlPPe6U

# Sandbox REST App Client Secret
# PASTE YOUR REAL SECRET IN LOCAL .env ONLY (this file is ignored by git).
PAYPAL_CLIENT_SECRET=PASTE_YOUR_SANDBOX_SECRET_HERE

# PayPal Webhook ID
# Create a webhook endpoint pointing to: https://<your-domain-or-tunnel>/api/billing/paypal/webhook
# Paste the resulting Webhook ID here:
PAYPAL_WEBHOOK_ID=PASTE_WEBHOOK_ID_HERE

# Product and Plan IDs
# Generated by running: python -m backend.billing.setup_paypal
PAYPAL_PRODUCT_ID=
PAYPAL_PLAN_PRO_ID=
PAYPAL_PLAN_PRO_PLUS_ID=
PAYPAL_PLAN_PRO_MAX_ID=

