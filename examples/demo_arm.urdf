<?xml version="1.0"?>
<!-- RoboForge demo: 4-DOF arm (base yaw, shoulder, elbow, wrist). Import via Robot Studio > URDF, or
     POST /api/robot/import-urdf {"urdf_xml": "<this file>", "set_as_active_robot": true} -->
<robot name="demo_arm">
  <link name="base_link">
    <visual><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.12" length="0.10"/></geometry>
      <material name="grey"><color rgba="0.55 0.57 0.60 1"/></material></visual>
    <collision><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.12" length="0.10"/></geometry></collision>
    <inertial><origin xyz="0 0 0.05"/><mass value="4.0"/><inertia ixx="0.02" iyy="0.02" izz="0.03" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>

  <link name="turret">
    <visual><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.07" length="0.10"/></geometry>
      <material name="white"><color rgba="0.93 0.93 0.92 1"/></material></visual>
    <collision><origin xyz="0 0 0.05"/><geometry><cylinder radius="0.07" length="0.10"/></geometry></collision>
    <inertial><origin xyz="0 0 0.05"/><mass value="1.2"/><inertia ixx="0.003" iyy="0.003" izz="0.003" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="base_yaw" type="revolute">
    <parent link="base_link"/><child link="turret"/><origin xyz="0 0 0.10"/><axis xyz="0 0 1"/>
    <limit lower="-3.0" upper="3.0" effort="40" velocity="2.0"/>
  </joint>

  <link name="upper_arm">
    <visual><origin xyz="0 0 0.15"/><geometry><box size="0.06 0.06 0.30"/></geometry>
      <material name="white"/></visual>
    <collision><origin xyz="0 0 0.15"/><geometry><box size="0.06 0.06 0.30"/></geometry></collision>
    <inertial><origin xyz="0 0 0.15"/><mass value="1.0"/><inertia ixx="0.008" iyy="0.008" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="turret"/><child link="upper_arm"/><origin xyz="0 0 0.10"/><axis xyz="0 1 0"/>
    <limit lower="-1.6" upper="1.6" effort="40" velocity="2.0"/>
  </joint>

  <link name="forearm">
    <visual><origin xyz="0 0 0.12"/><geometry><box size="0.05 0.05 0.24"/></geometry>
      <material name="grey"/></visual>
    <collision><origin xyz="0 0 0.12"/><geometry><box size="0.05 0.05 0.24"/></geometry></collision>
    <inertial><origin xyz="0 0 0.12"/><mass value="0.7"/><inertia ixx="0.004" iyy="0.004" izz="0.0005" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/><origin xyz="0 0 0.30"/><axis xyz="0 1 0"/>
    <limit lower="-2.3" upper="2.3" effort="25" velocity="2.5"/>
  </joint>

  <link name="gripper">
    <visual><origin xyz="0 0 0.04"/><geometry><box size="0.08 0.04 0.08"/></geometry>
      <material name="white"/></visual>
    <collision><origin xyz="0 0 0.04"/><geometry><box size="0.08 0.04 0.08"/></geometry></collision>
    <inertial><origin xyz="0 0 0.04"/><mass value="0.3"/><inertia ixx="0.0005" iyy="0.0005" izz="0.0005" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="wrist" type="revolute">
    <parent link="forearm"/><child link="gripper"/><origin xyz="0 0 0.24"/><axis xyz="0 1 0"/>
    <limit lower="-1.8" upper="1.8" effort="10" velocity="3.0"/>
  </joint>
</robot>
